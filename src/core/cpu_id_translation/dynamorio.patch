diff --git a/core/unix/os.c b/core/unix/os.c
index 3c22697..ee86fba 100644
--- a/core/unix/os.c
+++ b/core/unix/os.c
@@ -8530,6 +8530,32 @@ pre_system_call(dcontext_t *dcontext)
         /* we handle arch_prctl in post_syscall */
         dcontext->sys_param0 = sys_param(dcontext, 0);
         dcontext->sys_param1 = sys_param(dcontext, 1);
+        if (INTERNAL_OPTION(mangle_app_seg) && dcontext->sys_param0 == ARCH_SET_GS) {
+            /* The code-cache syscall return path already needs DR's GS.  Perform
+             * the kernel operation here and restore GS before re-entering that
+             * path.  Block delivery while the stolen register is unavailable.
+             */
+            kernel_sigset_t blocked, previous;
+            os_thread_data_t *ostd = dcontext->os_field;
+            void *dr_gs = ostd->priv_alt_tls_base;
+            memset(&blocked, 0xff, sizeof(blocked));
+            dynamorio_syscall(SYS_rt_sigprocmask, 4, SIG_SETMASK, &blocked, &previous,
+                              sizeof(blocked));
+            long result = dynamorio_syscall(SYS_arch_prctl, 2, ARCH_SET_GS,
+                                            dcontext->sys_param1);
+            long restored = dynamorio_syscall(SYS_arch_prctl, 2, ARCH_SET_GS, dr_gs);
+            ASSERT(restored == 0);
+            if (result == 0)
+                tls_handle_post_arch_prctl(dcontext, ARCH_SET_GS,
+                                           dcontext->sys_param1);
+            dynamorio_syscall(SYS_rt_sigprocmask, 4, SIG_SETMASK, &previous, NULL,
+                              sizeof(previous));
+            if (result == 0)
+                set_success_return_val(dcontext, 0);
+            else
+                set_failure_return_val(dcontext, -result);
+            execute_syscall = false;
+        }
         break;
     }
 #    endif
